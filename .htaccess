# ==========================================================================
# Emisha — configuración Apache (hosting compartido GoDaddy / cPanel)
# Sitio estático. Cada bloque va dentro de <IfModule> para que el sitio
# siga funcionando si el módulo no está habilitado en el servidor.
# ==========================================================================

# Documento por omisión de cada directorio.
DirectoryIndex index.html

# Página de error 404 personalizada.
ErrorDocument 404 /404.html

# --------------------------------------------------------------------------
# Redirecciones canónicas: forzar HTTPS y canonizar en www.
# --------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Forzar HTTPS.
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # emisha.com.mx -> www.emisha.com.mx (el dominio canónico lleva www)
  RewriteCond %{HTTP_HOST} ^emisha\.com\.mx$ [NC]
  RewriteRule ^(.*)$ https://www.emisha.com.mx/$1 [R=301,L]
</IfModule>

# --------------------------------------------------------------------------
# Tipos MIME que el hosting no siempre trae configurados.
# --------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/svg+xml .svg .svgz
</IfModule>

# --------------------------------------------------------------------------
# Compresión de texto (HTML, CSS, JS, SVG, JSON).
# --------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/ld+json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --------------------------------------------------------------------------
# Caché del navegador: imágenes y fuentes 1 año, CSS/JS 1 mes, HTML 1 hora.
# --------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # Imágenes y fuentes: contenido estable, se puede cachear un año.
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/gif               "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType image/x-icon            "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType font/woff               "access plus 1 year"
  ExpiresByType font/ttf                "access plus 1 year"

  # Hoja de estilos y JavaScript: 1 mes.
  ExpiresByType text/css                "access plus 1 month"
  ExpiresByType application/javascript  "access plus 1 month"
  ExpiresByType application/x-javascript "access plus 1 month"

  # HTML: 1 hora, para que los cambios de contenido se vean pronto.
  ExpiresByType text/html               "access plus 1 hour"
</IfModule>

# --------------------------------------------------------------------------
# Encabezados de seguridad.
# --------------------------------------------------------------------------
<IfModule mod_headers.c>
  # Impide que el navegador adivine el tipo MIME de un archivo.
  Header set X-Content-Type-Options "nosniff"

  # Envía el referer completo solo a destinos del mismo origen seguro.
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Solo el propio sitio puede embeber estas páginas en un frame.
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
